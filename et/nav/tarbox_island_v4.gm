global OnMapLoad = function()
{
    OnTrigger("Axis Command Post constructed. Charge speed increased!", Map.Axis_Command_Post_Built);    
    OnTrigger("Allied Command Post constructed. Charge speed increased!", Map.Allied_Command_Post_Built);
	OnTrigger("MISSING_STRING", Map.Allied_Command_Post_Destroyed);
	OnTrigger("MISSING_STRING", Map.Axis_Command_Post_Destroyed);    
	OnTrigger("axis east wall Destroyed.", Map.axis_east_wall_Destroyed);
	OnTrigger("axis north wall Destroyed.", Map.axis_north_wall_Destroyed);
	OnTrigger("axis west wall Destroyed.", Map.axis_west_wall_Destroyed);
	OnTrigger("the cone that contains the documents Destroyed.", Map.cone_that_contains_the_documents_Destroyed);
	OnTrigger("Allies have stolen the secret documents!", Map.secret_documents_Taken);
	OnTrigger("MISSING_STRING", Map.secret_documents_Returned);
	OnTrigger("Allied team have stolen the secret docs and won the game!!!", Map.secret_documents_Secured);
	OnTrigger("CHECKPOINT_forward_spawn to team 1", Map.forward_spawn_Axis_Captured);
	OnTrigger("CHECKPOINT_forward_spawn to team 2", Map.forward_spawn_Allies_Captured);

	//~Util.DisableGoal(".*", true);
	//~SetAvailableMapGoals(TEAM.AXIS, true, "ATTACK.*");
	//~SetAvailableMapGoals(TEAM.ALLIES, true, "ATTACK.*");

	//Util.SetMaxUsers(1, "MOUNTMG42.*");

	//SetMapGoalProperties("MOUNTMG42.*", {MinCampTime=15, MaxCampTime=90});


	Util.MapDebugPrint("Omni-bot map script for " + GetMapName() + " executed.");
};

