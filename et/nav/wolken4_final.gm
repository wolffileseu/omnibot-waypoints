{
	MapRoutes =
	{
		FLAG_spare_parts =
		{
		},
		PLANT_Gun_Controls =
		{
		},
		BUILD_Command_Post =
		{
		},
		PLANT_Command_Post =
		{
		},
		BUILD_mortar_launcher =
		{
		},
		PLANT_mortar_launcher =
		{
