global OnMapLoad = function()
{
	// Register callback functions



	OnTrigger( "Axis Command Post constructed. Charge speed increased!", Map.Axis_Command_Post_Built );
  OnTrigger( "Allied Command Post constructed. Charge speed increased!", Map.Allied_Command_Post_Built );
    
  OnTrigger( "Axis team has destroyed the Allied Command Post!", Map.Allied_Command_Post_Destroyed );
	OnTrigger( "Allied team has destroyed the Axis Command Post!", Map.Axis_Command_Post_Destroyed );

	OnTrigger( "MISSING_STRING", Map.Airships_Engine_Destroyed );
	OnTrigger( "Planted at the Airship's Engine.", Map.Airships_Engine_Planted );
	OnTrigger( "Defused at the Airship's Engine.", Map.Airships_Engine_Defused );


	OnTrigger( "Planted at the Main Entrance.", Map.Main_Entrance_Planted );
	OnTrigger( "Defused at the Main Entrance.", Map.Main_Entrance_Defused );
	OnTrigger( "Allies have destroyed the Main Entrance!", Map.Main_Entrance_Destroyed );

	OnTrigger( "Allies have destroyed the Top Entrance!", Map.Top_Entrance_Destroyed );
	OnTrigger( "Planted at the Top Entrance.", Map.Top_Entrance_Planted );
	OnTrigger( "Defused at the Top Entrance.", Map.Top_Entrance_Defused );

	OnTrigger( "Axis have reclaimed the Forward Spawn!", Map.forwardspawn1_flag_Axis_Captured );
	OnTrigger( "Allies have captured the Forward Spawn!", Map.forwardspawn1_flag_Allies_Captured );


SetGoalRole("PLANT_Main_Entrance", { ROLE.ATTACKER });
