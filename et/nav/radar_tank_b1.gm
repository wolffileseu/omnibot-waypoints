	Main_Entrance_Destroyed = function( trigger )
	{
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_frontgate_1" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_frontgate_2" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_frontgate_3" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_frontgate_4" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_frontgate_5" );
    SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_FRONTGATEBOOM");
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rBunkerEast3");
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rBunkerWest1");
        SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_a_1");
        SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_a_2");
            SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_zone_c_1");
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_zone_c_2");
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_zone_c_3");
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_zone_c_4");
	SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_zone_c_5");
	SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_North_Pak_75mm_gun" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_South_Pak_75mm_gun" );
                           Map.MainEntranceDestroyed = true;
        SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Tank");
		Util.MapDebugPrint( "^6Main_Entrance_IS_Destroyed" );
	},

	North_Pak_75mm_gun_Destroyed = function( trigger )
	{

         if (!Map.SouthPak75mmgunINTACT)
                {
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE.*");
   	SetGoalPriority( "PLANTMINE_rBunkerEast1", 0.0, TEAM.AXIS, CLASS.ENGINEER );
   	SetGoalPriority( "PLANTMINE_rBunkerEast2", 0.0, TEAM.AXIS, CLASS.ENGINEER );
        SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Tank");
	Wp.SetWaypointFlag("rightside","axis",false);
	Wp.SetWaypointFlag("rightsidemid","axis",false);
	Wp.SetWaypointFlag("rightsidewall","axis",false);
	Wp.SetWaypointFlag("bakmiddle","axis",false);
	Wp.SetWaypointFlag("bakleftwall","axis",false);
	Wp.SetWaypointFlag("bakrightwall","axis",false);
	Wp.SetWaypointFlag("frontleftside","axis",false);
        	Wp.SetWaypointFlag("thewall","axis",false);
        SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_b_1");
    SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_b_2");
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_b_3");
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_b_4");
	SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_zone_b_5");
        SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Main_Entrance");
        		Util.MapDebugPrint( "^5Both_North_Pak_75mm_gun_Destroyed_BUILD_TANK" );
                    }
        else if (Map.SouthPak75mmgunINTACT == true)
                {
	SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_South_PAK_75mm_Gun" );
        SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Tank");
        		Util.MapDebugPrint( "^1North_Pak_75mm_gun_Destroyed_PLANT_SOUTH" );
                    }
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rWestParts4");
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rEastParts1");
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rEastParts2");
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE_rEastParts3");
	SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_North_Pak_75mm_gun" ); 
                   Map.NorthPak75mmgunINTACT = false;
		Util.MapDebugPrint( "^6North_Pak_75mm_gun_Destroyed" );
	},

	South_PAK_75mm_Gun_Destroyed = function( trigger )
	{

         if (!Map.NorthPak75mmgunINTACT)
                {
    SetAvailableMapGoals( TEAM.AXIS, false, "PLANTMINE.*");
   	SetGoalPriority( "PLANTMINE_rBunkerEast1", 0.0, TEAM.AXIS, CLASS.ENGINEER );
