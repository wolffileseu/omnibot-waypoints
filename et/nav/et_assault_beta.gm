global Map =
{
	Debug = 0, // please set to zero before distributing your script
	b4truck = "b4_truck",
	b4wall  = "b4_wall",
	afterwall = "after_wall",
	endtankuse = "end_tank_use",
	AlliedCPBuilt = false,
	AxisCPBuilt = false,
 	spawndoorStatus = 0, //door is closed initially
	ShowMovers = false,
      Tank_Damaged = true,
	Cave_Door_Dyno = 0,
	Command_Post_Dyno = 0,
	Power_Generator_Dyno = 0,
	Side_Wall_Dyno = 0,
	Allied_Team_Inside_RadioRoom = 0,
      Allied_Eng_Inside_RadioRoom = 0,
	Door_Blown = false,
	Power_Generator_Destroyed = true,
	Flight_Gate_Destroyed = false,
	b4_truck = false,
	b4_wall = false,
	after_wall = false,
	end_tank_use = false,
    DispenseHealthTime = 0.1,//low number makes bot drop health packs
	DispenseAmmoTime = 0.3,//higher number leaves fieldops ability to call arty    
	DefendingTeam = TEAM.AXIS,
	Switches =
 	{
 		spawndoor =
 		{
 			Enabled = true,
 			Priority = 0, //always set to 0 when using path through
 			WaypointName = "spawndoor",
 			//Timeout = 4000,
 			//AimPosition = Vec3(1586.485, -1604.125, 63.045), // Optional 0.8x only, use /bot aim_pos to get aim vector. Replaces the unreliable waypoint facing.
                  LimitClass = (1<<CLASS.MEDIC) | (1<<CLASS.ENGINEER) | (1<<CLASS.SOLDIER),
			LimitBots = 1,
 		},
 	},

spawndoor_Moving = function ( trigger )
 {
 	if ( trigger.Action == "opening" )
 	{
 		Map.spawndoorStatus = 1; //open
 		Map.Switches.spawndoor.Enabled = false;
 		//print("door is opening");
 	}
 	else
 	{
 		Map.spawndoorStatus = 0; //closed
 		Map.Switches.spawndoor.Enabled = true;
 	}
 },
