	tank_at_location = function( trigger )
	{
		switch(Map.VehicleLocation)
		{
			case 1:
			{

		Map.b4_truck();
			}
			case 2:
			{

				Map.b4_wall();
			}
			case 3:
			{

				Map.after_wall();
			}
			case 4:
			{

				Map.end_tank_use();
			}
			case 5:
			{

		SetAvailableMapGoals( TEAM.AXIS, false, "MOBILEMORTAR_mrmorter_commandpost" );
            SetAvailableMapGoals( TEAM.AXIS, true, "MOBILEMORTAR_platform_2" );
			}
		}
		Util.MapDebugPrint("vehicle at location " + Map.VehicleLocation, true);
	},

//front_ladder_intruder = 
//south_stairs_intruder = 


	north_stairs_doc =
	{
		Name = "north_stairs_doc",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{ 
				if ( GetEntFlags( ent, ENTFLAG.CARRYINGGOAL ) )
				{
					//SetGoalPriority( "DEFEND_north_stairs", 0.9, TEAM.AXIS, 0 );
					//SetGoalPriority( "DEFEND_Radio_Room_.*", 1.0, TEAM.AXIS, 0 );
					SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder" );
		                  SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder_2" );
					SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_AfterTruck_6" );
		                  SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_AfterTruck_7" );
                          SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_AfterTruck_8" );
					SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_.*" );
					SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_north_stairs" );
						Util.BotChat( TEAM.AXIS, "sayteam", "^8The Allies Have stolen The Secret Documents and are using the NORTH stairs to reach the Radio Room to transmit them! Stop Them", 2 );
						
						Util.MapDebugPrint( "^3The Secret Documents and the allies are on the NORTH stairs " );
				}
			}
		},
	},
	
	south_stairs_doc =
	{
		Name = "south_stairs_doc",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{ 
				if ( GetEntFlags( ent, ENTFLAG.CARRYINGGOAL ) )
				{
					//SetGoalPriority( "DEFEND_south_stairs", 0.9, TEAM.AXIS, 0 );
					//SetGoalPriority( "DEFEND_Radio_Room_.*", 1.0, TEAM.AXIS, 0 );
				      SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder" );
		                  SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder_2" );
					SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_.*" );
					SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_south_stairs" );
						Util.BotChat( TEAM.AXIS, "sayteam", "^7The Allies Have stolen The Secret Documents and are using the SOUTH stairs to reach the Radio Room to transmit them! Stop Them", 2 );
						
						Util.MapDebugPrint( "^3The Secret Documents and the allies are on the SOUTH stairs " );
				}
			}
		},
	},
	
	

	radiopower_trigger =
 	{
 		Name="radiopower_trigger",
		TriggerOnClass = CLASS.ANYPLAYER,
		OnEnter = function(ent)
		{
			if( GetEntTeam(ent) == TEAM.ALLIES )
			{
			   if ( GetEntClass(ent) == CLASS.ENGINEER )
				      {
					Map.Allied_Eng_Inside_RadioRoom += 1;
					
						SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Power_Generator" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_1" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_2" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_3" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_4" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_Radio_Room_5" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_south_stairs" );
						SetAvailableMapGoals( TEAM.AXIS, true, "DEFEND_north_stairs" );
						SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder" );
		                        SetAvailableMapGoals( TEAM.AXIS, false, "DEFEND_frontladder_2" );
						
						Util.BotChat( TEAM.AXIS, "sayteam", "^2ALLIED ENGINEERS are in the radio room", 2 );
						Util.MapDebugPrint( "ALLIED ENGINEERS are in the radio room" );
				      }
				
 	
                  }
	      },								
      },
};	
	


global OnMapLoad = function()
{
	if ( TestMapOn )
		{ Util.AutoTestMap(); }

	// Register callback functions
	OnTrigger( "The Tank has been repaired!", Map.Tank_Built );
	OnTrigger( "Allied team has stolen the Tank!", Map.Tank_stolen );
	OnTrigger( "The Tank has been damaged!", Map.Tank_Damaged );
	OnTrigger( "allies_hq_tank_damaged_axis", Map.Tank_Damaged );
	OnTrigger( "Defused at the Side Wall.", Map.Side_Wall_Defused );
	OnTrigger( "Planted at the Side Wall.", Map.Side_Wall_Planted );
