	Door_Blown = function( trigger )
	{
	Map.Door_Blown = true;
		if ( TestMap )
			{ return; }
                   

		   //SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Command_Post" );
		   //SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		   SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Cave_Door" );		   
		   SetAvailableMapGoals( TEAM.ALLIES, false, "ESCORT_Tank" );
		   SetAvailableMapGoals( TEAM.ALLIES, false, "MOUNT_Tank" );
		   SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Tank" );
		 //SetGoalPriority( "DEFEND_AfterTruck_6", 0.98, TEAM.AXIS, 0 );
		  //SetGoalPriority( "DEFEND_AfterTruck_7", 0.98, TEAM.AXIS, 0 );
          //SetGoalPriority( "DEFEND_AfterTruck_8", 0.98, TEAM.AXIS, 0 );
	    Util.SetMaxUsers( 1, "PLANTMINE_path2docs_.*", TEAM.AXIS );
	    SetAvailableMapGoals( TEAM.AXIS, true, "PLANTMINE_path2docs_.*" );
	    Util.SetMaxUsers( 1, "TRIPMINE_*.*", TEAM.AXIS );
        SetAvailableMapGoals( TEAM.AXIS, true, "TRIPMINE_*.*" );		   
		   SetAvailableMapGoals( TEAM.AXIS, false, "MOVER_tank" );
		   SetAvailableMapGoals( TEAM.AXIS, false, "MOBILEMORTAR_mrmorter_commandpost" );		   
		   SetAvailableMapGoals( TEAM.AXIS, false, "MOBILEMORTAR_byflightgate2capturepoint" );		   
		   SetAvailableMapGoals( TEAM.AXIS, false, "MOUNT_Tank" );		   		   
               SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_B4Truck" );
               SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_AfterTruck" );
               SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_B4wall" );
               SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_atwalltower" );
               SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_afterwalltower" );
               //SetAvailableMapGoals( TEAM.AXIS, false, "AIRSTRIKE_lastwalltower" );
		   SetAvailableMapGoals( TEAM.AXIS, false, "CALLARTILLERY_19" );
		   SetAvailableMapGoals( TEAM.AXIS, false, "CALLARTILLERY_20" );
		if ( Map.Axis_CP_Built )
		{ 
		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Command_Post" );
		}
           if ( !Map.Command_Post_Built )
		{ 
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		}		
		   Util.MapDebugPrint( "Tank_Has_Door_Blown" );
	},



	Allied_CP_Built = function( trigger )
	{
		if ( TestMap )
			{ return; }
		
		Map.AlliedCPBuilt = true;
		
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Command_Post" );
		
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Command_Post" );
		
		SetAvailableMapGoals( TEAM.AXIS, true, "PLANT_Command_Post" );
		
		Util.MapDebugPrint( "^3Allied_CP_Built" );
	},
	
	Axis_CP_Built = function( trigger )
	{
		if ( TestMap )
			{ return; }
			
             Map.Axis_CP_Built = true;			
		SetAvailableMapGoals( TEAM.AXIS, false, "BUILD_Command_Post" );		
		SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Command_Post" );
		
		if ( Map.Door_Blown == true )
		{ 
		SetAvailableMapGoals( TEAM.ALLIES, true, "PLANT_Command_Post" );
		}
		else
		{ 
		SetAvailableMapGoals( TEAM.ALLIES, false, "PLANT_Command_Post" );
		}
		Util.MapDebugPrint( "^3Axis_CP_Built" );
	},
	
	Command_Post_Planted = function( trigger )
	{
		if ( TestMap )
			{ return; }
		
		Map.Command_Post_Dyno += 1;
		
		if ( Map.AlliedCPBuilt )
		{
			SetAvailableMapGoals( TEAM.ALLIES, true, "DEFUSE_Command_Post_.*" );
		}
		else
		{
			SetAvailableMapGoals( TEAM.AXIS, true, "DEFUSE_Command_Post_.*" );
		}
		
		Util.MapDebugPrint( "^3Command_Post_Planted" );
	},
	
	Command_Post_Defused = function( trigger )
	{
		if ( TestMap )
			{ return; }
		
		Map.Command_Post_Dyno -= 1;
		
		Util.MapDebugPrint( "^3Command_Post_Defused" );
	},
	
	Allied_CP_Destroyed = function( trigger )
	{
		if ( TestMap )
			{ return; }
		
		Map.AlliedCPBuilt = false;
		
		SetAvailableMapGoals( TEAM.AXIS, true, "BUILD_Command_Post" );
		SetAvailableMapGoals( TEAM.AXIS, false, "PLANT_Command_Post" );
		SetAvailableMapGoals( TEAM.ALLIES, true, "BUILD_Command_Post" );
		
		Util.MapDebugPrint( "^3Allied_CP_Destroyed" );
	},
	
