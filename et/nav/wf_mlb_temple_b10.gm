//  ---------------------------------------------------------------------------------------------
//  This is a Very Altered Script, 
// 
//  The Map also has a GLITCH. If the tank is about to cross the bridge, I do not mean at the bridge.
//  What I mean is the tank was going to go onto the bridge at the second the dyno exploded. 
//  When the track on the front of the tank is touching the ground at the very location
//  the bridge is touching the ground. Half of the Bridge will remain, the bridge is cut in half.
// 
//  LITERALLY - half the bridge, it is not completely destroyed nor is it half built.. It looks strange.
// 
//  When the second set of crates is available again, is it buildable? 
//  Will adding some CONDITIONALS fix the issue when the glitch happens?
//  Added a NEW trigger system for the tank but used the Original poorly placed trigger locations.
// TODO: Put in new triggerbounds - vehicle_trigger_locations  to replace the Original.
//==========================================================================================
//

global Map =
{
	Debug = 0, // please set to zero before distributing your script

	Quiet = false,

	//set Talk to false if you don't want the Allied bots to cheer after winning:
	Talk = true,

        GoldStolen = 0,
        TankBarrierDestroyed = true,
        TempleWoodedBarrierBuilt = false,
        TankBridgeCompleted = false,
        TankBridgeP1Completed = false,
        TempleMGNestBuilt = false,
        TempleCorridorWallCrackDestroyed = true,
        FloorBreachToEscapeCavesDestroyed = true,
        TempleCavesAccessBreachDestroyed = false,
        EscapeCavesScaffoldingBuilt = false,
        CanyonRopeBridgeBuilt = false,
        TankBarrier1Built = false,
        TankBuilt = true,
        goldget = 0,
	      Mover_tank = "MOVER_tank",

// this seems to make bots give out health packs and ammo better than DEFAULT does
	DispenseHealthTime = 15.0,
	DispenseAmmoTime = 1.0,

//DEFENDER = TEAM.AXIS
	Roles =
	{
		AXIS =
		{
			AllBots = true, // each bot is considered for a role
			
			DEFENDER =	
			{
				numbots = 5,
				crucialClass = CLASS.ENGINEER, CLASS.COVERTOPS,
			},
			DEFENDER1 =	
			{
				numbots = 5,
				crucialClass = CLASS.ENGINEER,  CLASS.COVERTOPS,
			},
			DEFENDER2 =	
			{
				numbots = 5,
				crucialClass = CLASS.ENGINEER, CLASS.MEDIC,
			},
			DEFENDER3 =	
			{
				numbots = 5,
				crucialClass = CLASS.FIELDOPS,
			},
            ROAMER =	
			{
				numbots = 5,
				crucialClass = CLASS.SOLDIER,
			},
		},
		
		ALLIES =
		{
			AllBots = true, // each bot is considered for a role
			
			ATTACKER =	
			{
				numbots = 8,
				crucialClass = CLASS.ENGINEER, CLASS.COVERTOPS,
			},
			ATTACKER1 =	
			{
				numbots = 5,
				crucialClass = CLASS.ENGINEER, CLASS.COVERTOPS, CLASS.MEDIC, 
			},
			ATTACKER2 =	
			{
				numbots = 5,
				crucialClass = CLASS.ENGINEER, CLASS.COVERTOPS, CLASS.MEDIC,
			},
			ATTACKER3 =	
