				numbots = 8,
				crucialClass = CLASS.COVERTOPS, CLASS.ENGINEER, 
			},
            ROAMER =	
			{
				numbots = 8,
				crucialClass = CLASS.COVERTOPS, 
			},
		},
	},

	//Tank stuff
	Tank_Built = function( trigger )
	{
	SetAvailableMapGoals( TEAM.ALLIES, true, "MOUNT_tank" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Tank" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ESCORT_Tank" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "BUILD_Tank" );
                      Map.TankBuilt = true;
		Util.MapDebugPrint( "^6Tank_Built" );
	},

	tank_reached_command_post_area = function( trigger )
	{
ClearGoalRole( "BUILD_Canyon_Rope_Bridge", { ROLE.ATTACKER, ROLE.ATTACKER1, ROLE.ATTACKER3 } );//remove at 6
  //ClearGoalRole("CALLARTILLERY_b4bridgebuilt", { ROLE.DEFENDER3 });
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_1" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_2" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_3" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_4" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_5" );
	SetAvailableMapGoals( TEAM.ALLIES, true, "ATTACK_a_barrier1_6" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_a_flag_1" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_a_flag_2" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "ATTACK_a_flag_3" );
	SetAvailableMapGoals( TEAM.AXIS, false, "MOBILEMORTAR_m_axis_1" );
        SetAvailableMapGoals( TEAM.AXIS, true, "ARTILLERY_S_BarrierBuster_1" );
        SetAvailableMapGoals( TEAM.AXIS, true, "ARTILLERY_S_BarrierBuster_2" );
	SetAvailableMapGoals( TEAM.ALLIES, false, "CHECKPOINT_flag1" );
	SetAvailableMapGoals( TEAM.AXIS, false, "CHECKPOINT_flag1" );
		SetAvailableMapGoals( TEAM.AXIS, false, "CALLARTILLERY_ar_call_6" );
		SetAvailableMapGoals( TEAM.AXIS, false, "CALLARTILLERY_ar_call_7" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ARTILLERY_S_ar_tank_6" );
		SetAvailableMapGoals( TEAM.AXIS, false, "ARTILLERY_S_ar_tank_7" );

		Util.MapDebugPrint( "^6tank_reached_command_post_area" );
	},

